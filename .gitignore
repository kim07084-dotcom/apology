# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js build / output
.next/
out/
.build/
build/

# Production
dist/

# Next.js & Vercel env files (do not commit secrets)
.env
.env.*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# TypeScript
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS generated files
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Misc caches
.cache/
.pnp.*
.tools/

# Optional: ignore local debug or OS-specific files
*.local

# Keep package lockfiles (recommended) - comment out if you prefer ignoring lockfile
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Avoid committing personal credentials or secrets placed in files
# (adjust patterns below if you use other filenames for secrets)
secrets.json
*.key
*.pem

# End of .gitignore
